        <mxCell id="wmbvdQVgA1cLZc2y_ULJ-41" value="&lt;font style=&quot;&quot;&gt;Will use conversation history later for context in the NLP layer.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=#0050ef;fontColor=light-dark(#FFFFFF,#FFFFFF);" vertex="1" parent="1">
