        <mxCell id="wmbvdQVgA1cLZc2y_ULJ-34" value="&lt;font style=&quot;&quot;&gt;Below a set threshold, discard the message at this point (likely not of &#39;interest&#39;).&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=#0050ef;fontColor=light-dark(#FFFFFF,#FFFFFF);" vertex="1" parent="1">
